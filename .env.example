# Banco (Supabase) — Settings → Database → Connection string (Transaction mode, porta 6543)
DATABASE_URL="postgresql://USER:PASSWORD@HOST:6543/postgres?pgbouncer=true"
# Direct connection (porta 5432) — só usada pelo `prisma migrate`
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/postgres"

# NextAuth
NEXTAUTH_SECRET="gere com: openssl rand -base64 32"
NEXTAUTH_URL="http://localhost:3000"

# Domínio do site (opcional — ver lib/site.ts)
NEXT_PUBLIC_SITE_URL="https://mrsresolve.com.br"
